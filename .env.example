# Neon (pooled) connection string — set in Vercel env and .env.local
DATABASE_URL=
# Dev-only: comma separated emails allowed to receive mail from non-production envs
DEV_EMAIL_ALLOWLIST=

# Optional: lets the PDF tab ask Claude which printed label belongs to which field (names only). Without it a local matcher is used.
ANTHROPIC_API_KEY=

# SMS (production only; without SMS_PROVIDER, or =console, messages are only logged)
SMS_PROVIDER=
SMS4FREE_API_KEY=
SMS4FREE_USERNAME=
SMS4FREE_PASSWORD=
# English letters, up to 11 (must be approved in the SMS4Free account)
SMS4FREE_SENDER=
